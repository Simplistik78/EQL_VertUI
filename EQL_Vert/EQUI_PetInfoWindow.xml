	<!-- PIWDragBox1 covers window y 1..17 - the "Pet:" label strip, which is
	     the only band with nothing interactive in it.  It was y 72..90, which
	     was harmless while PetInfoSubWindow started at y=70 (buttons then sat
	     at window y 126..174).  Pulling the sub-window up to y=2 to reclaim the
	     old buff strip moved the buttons to y 58..106, putting them straight
	     under the drag box - hence the move cursor over them.
	     The DragBox is anchored to PetInfoWindow, not to the sub-window, so it
	     did not travel with the rest of the body. -->
	<DragBox item="PIWDragBox1">
        <ScreenID>PIWDragBox1</ScreenID>
		<AutoStretch>true</AutoStretch>		
		<TopAnchorToTop>true</TopAnchorToTop>
		<LeftAnchorToLeft>true</LeftAnchorToLeft>
		<RightAnchorToLeft>false</RightAnchorToLeft>
		<BottomAnchorToTop>true</BottomAnchorToTop>
		<TopAnchorOffset>1</TopAnchorOffset>
		<LeftAnchorOffset>0</LeftAnchorOffset>
		<RightAnchorOffset>0</RightAnchorOffset>
		<BottomAnchorOffset>17</BottomAnchorOffset>
        <BackgroundTextureTint>
            <R>255</R>
            <G>0</G>
            <B>0</B>
        </BackgroundTextureTint>
        <Style_Transparent>true</Style_Transparent>
    </DragBox>

