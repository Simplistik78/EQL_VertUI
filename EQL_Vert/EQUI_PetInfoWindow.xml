<!-- ===== Vert accents =====
     No new textures: OS_A_GWHBar and the rail both come from atlases
     already installed for the group window.  StaticAnimation supports
     AutoStretch (GW_H_barblack in EQUI_GroupWindow.xml does the same
     thing), so a 125x14 bar and a 14x172 rail stretch to any size.

     The command buttons cannot move, so every accent sits in a gap
     around them.  Three horizontal rules at y 50, 106 and 156.
     -->
	<StaticAnimation item="PIW_VertRule1">
		<ScreenID>PIW_VertRule1</ScreenID>
		<RelativePosition>true</RelativePosition>
		<AutoStretch>true</AutoStretch>
		<TopAnchorToTop>true</TopAnchorToTop>
		<BottomAnchorToTop>true</BottomAnchorToTop>
		<LeftAnchorToLeft>true</LeftAnchorToLeft>
		<RightAnchorToLeft>false</RightAnchorToLeft>
		<TopAnchorOffset>50</TopAnchorOffset>
		<BottomAnchorOffset>54</BottomAnchorOffset>
		<LeftAnchorOffset>3</LeftAnchorOffset>
		<RightAnchorOffset>3</RightAnchorOffset>
		<Animation>OS_A_GWHBar</Animation>
	</StaticAnimation>
